<Window x:Class="QuadSync.Control.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:QuadSync.Control"
        Title="QuadSync Audio · 四声道声学控制台" Width="1240" Height="890" MinWidth="1060" MinHeight="800" Background="#0C111B" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13" Loaded="OnLoaded" Closing="OnClosing">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid Margin="30,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="◉" Foreground="{StaticResource Accent}" FontSize="30" Margin="0,0,12,0"/><TextBlock Text="QuadSync" FontSize="30" FontWeight="SemiBold"/><TextBlock Text=" AUDIO" FontSize="16" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="8,0,0,5"/></StackPanel><TextBlock Text="四声道声学控制台  /  DUAL DEVICE · ONE TIMELINE" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel>
      <Border Grid.Column="1" Background="#152C2C" CornerRadius="6" Padding="14,9" VerticalAlignment="Center"><TextBlock Text="48 kHz   /   FLOAT 32   /   EXCLUSIVE" Foreground="{StaticResource Accent}" FontSize="11"/></Border>
    </Grid>
    <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="12" Padding="20" Margin="0,0,0,18">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="设备 A · 前置左右 / 主时钟" Foreground="{StaticResource Muted}" Margin="0,0,0,9"/><ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding DeviceA}" DisplayMemberPath="Label" IsEnabled="{Binding CanConfigure}" AutomationProperties.Name="前置声卡"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="设备 B · 后置左右 / 跟随时钟" Foreground="{StaticResource Muted}" Margin="0,0,0,9"/><ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding DeviceB}" DisplayMemberPath="Label" IsEnabled="{Binding CanConfigure}" AutomationProperties.Name="后置声卡"/></StackPanel>
        <Button Grid.Column="3" Content="刷新设备" Margin="16,25,0,0" Click="RefreshClick" IsEnabled="{Binding CanConfigure}"/>
        <Grid Grid.Row="1" Grid.ColumnSpan="4" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <ComboBox SelectedIndex="{Binding SourceIndex}" IsEnabled="{Binding CanConfigure}" AutomationProperties.Name="音源"><ComboBoxItem Content="校音信号 · −24 dBFS"/><ComboBoxItem Content="WAV 文件 · 48 kHz"/><ComboBoxItem Content="外部四通道 PCM"/></ComboBox>
          <TextBox Grid.Column="1" Text="{Binding WavPath}" IsReadOnly="True" Margin="12,0,0,0" VerticalContentAlignment="Center" ToolTip="支持 48 kHz 双声道或四声道 WAV"/>
          <Button Grid.Column="2" Content="选择 WAV" Margin="10,0" Click="BrowseClick" IsEnabled="{Binding CanConfigure}"/>
          <CheckBox Grid.Column="3" Content="循环" IsChecked="{Binding Loop}" VerticalAlignment="Center" IsEnabled="{Binding CanConfigure}"/>
        </Grid>
      </Grid>
    </Border>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
      <Border Background="{StaticResource Panel}" CornerRadius="12" Padding="20,18">
        <StackPanel><DockPanel Margin="0,0,0,20"><TextBlock Text="CHANNEL STRIPS" FontWeight="SemiBold"/><TextBlock Text="独立增益 / 声学延迟" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/></DockPanel>
          <ItemsControl ItemsSource="{Binding Channels}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
            <Border BorderBrush="#263246" BorderThickness="0,0,1,0" Padding="10,0"><StackPanel>
              <TextBlock Text="{Binding Number}" Foreground="{StaticResource Accent}" FontSize="11" HorizontalAlignment="Center"/>
              <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,3"/>
              <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
              <Grid Height="240" Margin="0,18,0,8" HorizontalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="20"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                <Grid Height="220"><TextBlock Text="+6" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Top"/><TextBlock Text="0" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,20,0,0"/><TextBlock Text="−12" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,60,0,0"/><TextBlock Text="−24" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,100,0,0"/><TextBlock Text="−36" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,140,0,0"/><TextBlock Text="−60" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom"/></Grid>
                <Border Grid.Column="1" Width="9" Height="220" Background="#080E16" CornerRadius="4" VerticalAlignment="Center"><Grid ClipToBounds="True"><Border Height="{Binding Meter}" VerticalAlignment="Bottom" CornerRadius="3"><Border.Background><LinearGradientBrush StartPoint="0,1" EndPoint="0,0"><GradientStop Color="#27AC9A" Offset="0"/><GradientStop Color="#6CF1C2" Offset="0.8"/><GradientStop Color="#FFD27A" Offset="1"/></LinearGradientBrush></Border.Background></Border></Grid></Border>
                <Slider Grid.Column="2" Height="220" Style="{StaticResource Fader}" Value="{Binding GainDb,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Name}"/>
              </Grid>
              <TextBlock Text="{Binding GainDb,StringFormat={}{0:+0.0;-0.0;0.0} dB}" FontSize="18" HorizontalAlignment="Center"/>
              <TextBlock Text="{Binding PeakText}" Foreground="{StaticResource Muted}" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,18"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="68"/></Grid.ColumnDefinitions><TextBox Text="{Binding DelayValue,StringFormat=F1,UpdateSourceTrigger=LostFocus,ValidatesOnExceptions=True}" HorizontalContentAlignment="Center" ToolTip="0–100 ms，或 0–34.3 m" AutomationProperties.Name="声道延迟"/><ComboBox Grid.Column="1" ItemsSource="{Binding Units}" SelectedItem="{Binding Unit}" Margin="5,0,0,0"/></Grid>
              <TextBlock Text="{Binding DelayCaption}" FontSize="9" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel></Border>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="12" Padding="20,18"><StackPanel>
        <TextBlock Text="MASTER OUTPUT" FontWeight="SemiBold"/>
        <local:Knob Value="{Binding Master}" Width="202" Height="202" Margin="0,15,0,0" AutomationProperties.Name="总音量旋钮"/>
        <CheckBox Content="MUTE  /  全局静音" IsChecked="{Binding Muted}" HorizontalAlignment="Center" Margin="0,0,0,20"/>
        <Border Height="1" Background="#2B3649" Margin="0,0,0,18"/>
        <TextBlock Text="CLOCK SYNC" FontSize="11" Foreground="{StaticResource Muted}"/>
        <TextBlock Text="{Binding LagLabel}" FontSize="24" Margin="0,7,0,3" Foreground="{StaticResource Accent}"/>
        <TextBlock Text="{Binding SyncLabel}" FontSize="11" Foreground="{StaticResource Muted}"/>
        <TextBlock Text="{Binding RatioLabel}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
        <TextBlock Text="{Binding BufferLabel}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
        <Button Content="{Binding TransportLabel}" Background="{StaticResource Accent}" Foreground="#082824" FontWeight="SemiBold" Margin="0,22,0,0" Click="TransportClick" IsEnabled="{Binding CanTransport}"/>
      </StackPanel></Border>
    </Grid>
    <Grid Grid.Row="3" Margin="2,18,2,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,20,0"/><TextBlock Grid.Column="1" Text="{Binding CountersLabel}" Foreground="{StaticResource Muted}" FontSize="11"/></Grid>
  </Grid>
  </ScrollViewer>
</Window>
